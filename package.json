{
  "name": "spaced-dive",
  "version": "0.1.0",
  "description": "Review whole notes on a forgetting curve with folder-balanced weighted picking.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --outfile=skills/spaced-dive/spaced-dive.cjs --log-level=warning",
    "deploy": "node scripts/deploy.mjs",
    "skill": "node scripts/sync-skill.mjs",
    "ship": "npm run lint && npm test && npm run test:cli && npm run build:cli && npm run build && npm run skill",
    "test:cli": "esbuild tests/cli.ts --bundle --platform=node --format=cjs --outfile=tests/.cli.js --log-level=warning && node tests/.cli.js",
    "test": "esbuild tests/smoke.ts --bundle --platform=node --format=cjs --outfile=tests/.smoke.js --log-level=warning && node tests/.smoke.js",
    "lint": "eslint src",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "spaced-repetition",
    "forgetting-curve",
    "ebbinghaus"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6iedog/obsidian-spaced-dive.git"
  },
  "bugs": {
    "url": "https://github.com/6iedog/obsidian-spaced-dive/issues"
  },
  "homepage": "https://github.com/6iedog/obsidian-spaced-dive#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
